# Venti-Ate — Ortam Değişkenleri Örneği
# Bu dosyayı .env.local olarak kopyalayıp gerçek değerlerle doldurun.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Venti-Ate"

# İletişim (placeholder — gerçek bilgiyle değiştirin)
NEXT_PUBLIC_CONTACT_EMAIL="[İLETİŞİM E-POSTASI EKLENECEK]"
NEXT_PUBLIC_CONTACT_PHONE="[TELEFON NUMARASI EKLENECEK]"

# Ödeme sağlayıcısı (henüz belirlenmedi — soyut katman, demo checkout)
PAYMENT_PROVIDER_API_KEY="[ÖDEME SAĞLAYICI ANAHTARI EKLENECEK]"

# Analytics (opsiyonel)
NEXT_PUBLIC_VERCEL_ANALYTICS="false"
